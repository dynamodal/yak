{
  "name": "yak",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:ci": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "e2e": "node scripts/e2e/run.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:prod-bundle": "node scripts/check-prod-bundle.mjs",
    "release:obsidian": "scripts/release-obsidian.sh",
    "build:obsidian": "tsc --noEmit && vite build -c obsidian/vite.config.ts && cp obsidian/manifest.json obsidian/dist/manifest.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/ws": "^8.18.2",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "jsqr": "^1.4.0",
    "lib0": "^0.2.119",
    "preact": "^11.0.2",
    "qrcode-generator": "^2.0.4",
    "y-codemirror.next": "^0.3.6",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yaml": "^2.9.1",
    "yjs": "^13.6.33"
  }
}
